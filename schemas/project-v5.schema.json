{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://track-ed.dev/schemas/project-v5.schema.json",
  "title": "track-ed project v5",
  "description": "Authoring format for track-ed project@5 venues with unified roadside splines. Semantic rules are defined in docs/contracts/project-v5.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "name",
    "generator",
    "road",
    "terrain",
    "sections",
    "spawn"
  ],
  "properties": {
    "schema": {
      "const": "track-ed/project@5"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "generator": {
      "type": "string",
      "minLength": 1
    },
    "road": {
      "$ref": "#/$defs/road"
    },
    "terrain": {
      "$ref": "#/$defs/terrain"
    },
    "spawn": {
      "$ref": "#/$defs/spawn"
    },
    "cameras": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/camera"
      },
      "default": []
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/section"
      }
    },
    "junctions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/junction"
      },
      "default": []
    },
    "kerbs": {
      "$ref": "#/$defs/kerbProfile"
    }
  },
  "$defs": {
    "vec2": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "vec3": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "items": false,
      "minItems": 3,
      "maxItems": 3
    },
    "road": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "halfWidth",
        "shoulderHalfWidth"
      ],
      "properties": {
        "halfWidth": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "shoulderHalfWidth": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "terrain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "margin"
      ],
      "properties": {
        "margin": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "elevation": {
          "$ref": "#/$defs/elevation"
        },
        "mode": {
          "enum": [
            "conform",
            "follow"
          ],
          "default": "conform"
        },
        "points": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/terrainPoint"
          }
        }
      }
    },
    "spawn": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "centerline",
        "fraction"
      ],
      "properties": {
        "centerline": {
          "type": "string",
          "minLength": 1
        },
        "fraction": {
          "type": "number",
          "minimum": 0,
          "exclusiveMaximum": 1
        },
        "lateral": {
          "type": "number",
          "default": 0
        }
      }
    },
    "camera": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "position",
        "target",
        "fovY"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "position": {
          "$ref": "#/$defs/vec3"
        },
        "target": {
          "$ref": "#/$defs/vec3"
        },
        "fovY": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "spline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "const": "catmull-rom"
        },
        "samplesPerSegment": {
          "type": "integer",
          "minimum": 2,
          "maximum": 64,
          "default": 12
        }
      },
      "default": {
        "type": "catmull-rom",
        "samplesPerSegment": 12
      }
    },
    "elevation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "amplitude",
        "wavelength"
      ],
      "properties": {
        "amplitude": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "wavelength": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "phase": {
          "type": "number",
          "default": 0
        },
        "blend": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 20
        },
        "gridSpacing": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 10
        }
      }
    },
    "terrainPoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "position",
        "height"
      ],
      "properties": {
        "position": {
          "$ref": "#/$defs/vec2"
        },
        "height": {
          "type": "number"
        }
      }
    },
    "centerlinePoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "position"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "position": {
          "$ref": "#/$defs/vec2"
        }
      }
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "closed",
        "points"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "closed": {
          "type": "boolean"
        },
        "points": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/centerlinePoint"
          }
        },
        "spline": {
          "$ref": "#/$defs/spline"
        },
        "roadside": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/roadsideSpline"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "closed": {
                "const": true
              }
            },
            "required": [
              "closed"
            ]
          },
          "then": {
            "properties": {
              "points": {
                "minItems": 3
              }
            }
          }
        }
      ]
    },
    "junctionMember": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "section",
        "point"
      ],
      "properties": {
        "section": {
          "type": "string",
          "minLength": 1
        },
        "point": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "junction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "members"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "members": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/junctionMember"
          }
        },
        "anchor": {
          "$ref": "#/$defs/junctionMember"
        }
      }
    },
    "kerbProfile": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "flatHeight": {
          "type": "number",
          "minimum": 0
        },
        "cornerHeight": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "roadsideSpline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "side",
        "offset"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "side": {
          "enum": [
            "left",
            "right"
          ]
        },
        "offset": {
          "type": "number",
          "minimum": 0
        },
        "runs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/roadsideRun"
          },
          "default": []
        },
        "role": {
          "enum": [
            "kerb-left",
            "kerb-right"
          ]
        }
      }
    },
    "roadsideRun": {
      "oneOf": [
        {
          "$ref": "#/$defs/kerbRoadsideRun"
        },
        {
          "$ref": "#/$defs/wallRoadsideRun"
        },
        {
          "$ref": "#/$defs/instanceRoadsideRun"
        }
      ]
    },
    "kerbRoadsideRun": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "start",
        "length"
      ],
      "properties": {
        "kind": {
          "const": "kerb"
        },
        "start": {
          "type": "number",
          "minimum": 0,
          "exclusiveMaximum": 1
        },
        "length": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "flatHeight": {
          "type": "number",
          "minimum": 0
        },
        "cornerHeight": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "wallRoadsideRun": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "start",
        "length"
      ],
      "properties": {
        "kind": {
          "const": "wall"
        },
        "start": {
          "type": "number",
          "minimum": 0,
          "exclusiveMaximum": 1
        },
        "length": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "instanceRoadsideRun": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "start",
        "length"
      ],
      "properties": {
        "kind": {
          "enum": [
            "tree",
            "tyre",
            "block"
          ]
        },
        "start": {
          "type": "number",
          "minimum": 0,
          "exclusiveMaximum": 1
        },
        "length": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "spacing": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "collision": {
          "enum": [
            "solid",
            "none"
          ]
        },
        "outwardOffset": {
          "type": "number",
          "minimum": 0
        }
      }
    }
  }
}
