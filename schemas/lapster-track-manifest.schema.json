{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://track-ed.dev/schemas/lapster-track-manifest.schema.json",
  "title": "sim-track-glb-v1 track manifest",
  "description": "Pinned Lapster GLB track manifest for the lapster-glb-track@4 export profile.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "kind", "name", "length", "spawn", "visual", "collision", "surfaces", "default_surface"],
  "properties": {
    "schema": {
      "const": "sim-track-glb-v1"
    },
    "kind": {
      "const": "track"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "length": {
      "type": "number",
      "minimum": 0
    },
    "spawn": {
      "$ref": "#/$defs/spawn"
    },
    "cameras": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/camera"
      },
      "default": []
    },
    "visual": {
      "$ref": "#/$defs/visual"
    },
    "collision": {
      "$ref": "#/$defs/collision"
    },
    "surfaces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/surface"
      }
    },
    "default_surface": {
      "type": "integer",
      "minimum": 0,
      "maximum": 65535
    }
  },
  "$defs": {
    "vec3": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "items": false,
      "minItems": 3,
      "maxItems": 3
    },
    "quat": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        },
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "items": false,
      "minItems": 4,
      "maxItems": 4
    },
    "spawn": {
      "type": "object",
      "additionalProperties": false,
      "required": ["position", "rotation_xyzw"],
      "properties": {
        "position": {
          "$ref": "#/$defs/vec3"
        },
        "rotation_xyzw": {
          "$ref": "#/$defs/quat"
        }
      }
    },
    "camera": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "position", "target", "fov_y"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "position": {
          "$ref": "#/$defs/vec3"
        },
        "target": {
          "$ref": "#/$defs/vec3"
        },
        "fov_y": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "visual": {
      "type": "object",
      "additionalProperties": false,
      "required": ["glb", "include"],
      "properties": {
        "glb": {
          "type": "string",
          "minLength": 1
        },
        "include": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "scale": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 1
        },
        "yaw_degrees": {
          "type": "number",
          "default": 0
        },
        "offset": {
          "$ref": "#/$defs/vec3",
          "default": [0, 0, 0]
        }
      }
    },
    "collision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["include"],
      "properties": {
        "include": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      }
    },
    "surface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "friction", "roughness", "materials"],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "friction": {
          "type": "number"
        },
        "roughness": {
          "type": "number"
        },
        "materials": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "mountable": {
          "type": "boolean",
          "default": false
        }
      }
    }
  }
}
