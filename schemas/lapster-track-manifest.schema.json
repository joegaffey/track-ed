{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://track-ed.dev/schemas/lapster-track-manifest.schema.json",
  "title": "sim-track-glb-v2 track manifest",
  "description": "Pinned Lapster GLB track manifest for the lapster-glb-track@5 export profile.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "kind",
    "name",
    "length",
    "spawn",
    "visual",
    "collision",
    "surfaces",
    "default_surface"
  ],
  "properties": {
    "schema": {
      "const": "sim-track-glb-v2"
    },
    "kind": {
      "const": "track"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "length": {
      "type": "number",
      "minimum": 0
    },
    "spawn": {
      "$ref": "#/$defs/spawn"
    },
    "cameras": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/camera"
      },
      "default": []
    },
    "visual": {
      "$ref": "#/$defs/visual"
    },
    "collision": {
      "$ref": "#/$defs/collision"
    },
    "surfaces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/surface"
      }
    },
    "default_surface": {
      "type": "integer",
      "minimum": 0,
      "maximum": 65535
    },
    "race": {
      "$ref": "#/$defs/race"
    }
  },
  "$defs": {
    "vec3": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "items": false,
      "minItems": 3,
      "maxItems": 3
    },
    "quat": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        },
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "items": false,
      "minItems": 4,
      "maxItems": 4
    },
    "spawn": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "position",
        "rotation_xyzw"
      ],
      "properties": {
        "position": {
          "$ref": "#/$defs/vec3"
        },
        "rotation_xyzw": {
          "$ref": "#/$defs/quat"
        }
      }
    },
    "camera": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "position",
        "target",
        "fov_y"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "position": {
          "$ref": "#/$defs/vec3"
        },
        "target": {
          "$ref": "#/$defs/vec3"
        },
        "fov_y": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "visual": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "glb",
        "include"
      ],
      "properties": {
        "glb": {
          "type": "string",
          "minLength": 1
        },
        "include": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "scale": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 1
        },
        "yaw_degrees": {
          "type": "number",
          "default": 0
        },
        "offset": {
          "$ref": "#/$defs/vec3",
          "default": [
            0,
            0,
            0
          ]
        }
      }
    },
    "collision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "include"
      ],
      "properties": {
        "include": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      }
    },
    "surface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "friction",
        "roughness",
        "materials"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "friction": {
          "type": "number"
        },
        "roughness": {
          "type": "number"
        },
        "materials": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "mountable": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "direction": {
      "type": "string",
      "enum": [
        "forward",
        "reverse"
      ]
    },
    "grid_slot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "position",
        "rotation_xyzw"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "position": {
          "$ref": "#/$defs/vec3"
        },
        "rotation_xyzw": {
          "$ref": "#/$defs/quat"
        }
      }
    },
    "sector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "start_fraction",
        "end_fraction"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "start_fraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "end_fraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "race": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "layout",
        "start_finish",
        "grid",
        "sectors"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "layout": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "layout_id",
            "closed",
            "direction",
            "points",
            "half_width"
          ],
          "properties": {
            "layout_id": {
              "type": "string",
              "minLength": 1
            },
            "closed": {
              "const": true
            },
            "direction": {
              "$ref": "#/$defs/direction"
            },
            "points": {
              "type": "array",
              "minItems": 3,
              "items": {
                "$ref": "#/$defs/vec3"
              }
            },
            "half_width": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        "start_finish": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "section_id",
            "fraction",
            "position",
            "rotation_xyzw"
          ],
          "properties": {
            "section_id": {
              "type": "string",
              "minLength": 1
            },
            "fraction": {
              "type": "number",
              "minimum": 0,
              "exclusiveMaximum": 1
            },
            "position": {
              "$ref": "#/$defs/vec3"
            },
            "rotation_xyzw": {
              "$ref": "#/$defs/quat"
            }
          }
        },
        "grid": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/grid_slot"
          }
        },
        "sectors": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/sector"
          }
        }
      }
    }
  }
}
